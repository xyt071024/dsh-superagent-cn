{
  "name": "dsh-superagent",
  "author": "DeepSeek Harness Team <team@dsh.dev>",
  "license": "MIT",
  "version": "0.2.0",
  "private": true,
  "description": "一个给 DeepSeek Harness 用的主动型 super agent：监听 GitHub、QQ、邮箱与飞书，按 Policy 评估请求，把授权的变成 Ticket，在各自的 DSH 会话里执行，可多模型并行、可自我检查。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./github-watch": "./lib/github-watch.js",
    "./feishu-watch": "./lib/feishu-watch.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./qq-watch": "./lib/qq-watch.js",
    "./mail-watch": "./lib/mail-watch.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "prompts",
    "skills"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "manifestVersion": 1
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.1-alpha.2"
  },
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "proper-lockfile": "4.1.2",
    "zod": "4.4.3"
  },
  "peerDependencies": {
